+// ── BACKTEST TAB ──────────────────────────────────────────────────────────
+let btStrategies = [];
+let btLastResults = {};   // strategy_id -> full result (for detail view)
+let btEquityChart = null;
+
+async function loadBacktestStrategies() {
+  if(btStrategies.length) return;  // already loaded
+  try {
+    const r = await apiFetch('/api/backtest/strategies');
+    btStrategies = r.strategies || [];
+    const wrap = $('bt-strategy-checks');
+    wrap.innerHTML = btStrategies.map(s => `
+      <label style="display:flex;align-items:center;gap:5px;font-size:12px;background:#0d1117;border:1px solid #30363d;border-radius:6px;padding:6px 10px;cursor:pointer">
+        <input type="checkbox" class="bt-strat-cb" value="${s.id}" checked style="cursor:pointer">
+        ${s.name}
+      </label>
+    `).join('');
+  } catch(e) {
+    $('bt-strategy-checks').innerHTML = `<span style="color:#f85149;font-size:11px">Failed to load strategies: ${e.message}</span>`;
+  }
+}
+
+function fmtMetric(v, suffix) {
+  if(v === null || v === undefined) return '—';
+  return v + (suffix || '');
+}
+
+async function runBacktestCompare() {
+  const symbol = $('bt-sym').value.trim();
+  const interval = $('bt-interval').value;
+  const period = $('bt-period').value;
+  const initial_equity = parseFloat($('bt-equity').value) || 10000;
+  const risk_pct = parseFloat($('bt-risk').value) || 0.5;
+  const strategy_ids = Array.from(document.querySelectorAll('.bt-strat-cb:checked')).map(cb => cb.value);
+
+  if(!symbol) { alert('Enter a symbol first (e.g. GC=F for gold futures).'); return; }
+  if(!strategy_ids.length) { alert('Select at least one strategy.'); return; }
+
+  const btn = $('bt-run-btn');
+  btn.disabled = true;
+  $('bt-status').textContent = '⏳ Fetching data & running backtests…';
+  $('bt-results-wrap').style.display = 'none';
+  $('bt-detail-wrap').style.display = 'none';
+
+  try {
+    const r = await apiPost('/api/backtest/compare', {
+      symbol, interval, period, strategy_ids, initial_equity, risk_pct,
+    });
+    if(r.error) throw new Error(r.error);
+
+    btLastResults = {};
+    r.results.forEach(res => { if(!res.error) btLastResults[res.strategy_id] = res; });
+
+    const rows = r.results.map(res => {
+      if(res.error) {
+        return `<tr><td colspan="9" style="color:#f85149">${res.strategy_id}: ${res.error}</td></tr>`;
+      }
+      const m = res.metrics;
+      const isBest = r.ranking_by_return[0] === res.strategy_id;
+      return `<tr style="${isBest ? 'background:#0d2818' : ''}">
+        <td style="text-align:left">${isBest ? '🏆 ' : ''}${res.strategy_name}</td>
+        <td>${fmtMetric(m.num_trades)}</td>
+        <td>${fmtMetric(m.win_rate,'%')}</td>
+        <td>${fmtMetric(m.profit_factor)}</td>
+        <td>${fmtMetric(m.expectancy_R)}</td>
+        <td style="color:${m.max_drawdown_pct < -20 ? '#f85149':'#8b949e'}">${fmtMetric(m.max_drawdown_pct,'%')}</td>
+        <td style="color:${m.total_return_pct >= 0 ? '#3fb950':'#f85149'}">${fmtMetric(m.total_return_pct,'%')}</td>
+        <td>$${fmtMetric(m.final_equity)}</td>
+        <td><button class="btn btn-n btn-s" onclick="showBacktestDetail('${res.strategy_id}')">View</button></td>
+      </tr>`;
+    }).join('');
+
+    $('bt-results-body').innerHTML = rows;
+    $('bt-results-wrap').style.display = '';
+    $('bt-status').textContent = `✅ Done — ${r.results.length} strategies on ${r.symbol} (${r.interval})`;
+
+    if(r.ranking_by_return.length) showBacktestDetail(r.ranking_by_return[0]);
+  } catch(e) {
+    $('bt-status').textContent = `❌ ${e.message}`;
+  } finally {
+    btn.disabled = false;
+  }
+}
+
+function showBacktestDetail(strategyId) {
+  const res = btLastResults[strategyId];
+  if(!res) return;
+
+  $('bt-detail-title').textContent = `📈 ${res.strategy_name} — Equity Curve`;
+  $('bt-detail-sub').textContent = `${res.symbol} · ${res.interval} · ${res.data_range.start} → ${res.data_range.end} · ${res.num_bars} bars`;
+  $('bt-detail-wrap').style.display = '';
+
+  const ctx = $('bt-equity-chart');
+  btEquityChart = destroyChart(btEquityChart);
+  btEquityChart = new Chart(ctx, {
+    type: 'line',
+    data: {
+      labels: res.equity_curve.t,
+      datasets: [{
+        label: 'Equity ($)',
+        data: res.equity_curve.v,
+        borderColor: '#58a6ff',
+        backgroundColor: 'rgba(88,166,255,0.08)',
+        fill: true,
+        pointRadius: 0,
+        borderWidth: 1.5,
+      }],
+    },
+    options: {
+      responsive: true, maintainAspectRatio: false,
+      plugins: { legend: { display: false } },
+      scales: {
+        x: { ticks: { maxTicksLimit: 10, color: '#8b949e' }, grid: { color: '#21262d' } },
+        y: { ticks: { color: '#8b949e' }, grid: { color: '#21262d' } },
+      },
+    },
+  });
+
+  const trades = res.trades.slice().reverse();
+  $('bt-trades-body').innerHTML = trades.length ? trades.map(t => `
+    <tr>
+      <td style="color:${t.side==='LONG'?'#3fb950':'#f85149'}">${t.side}</td>
+      <td>${t.entry_time}</td>
+      <td>${t.entry_price}</td>
+      <td>${t.exit_price}</td>
+      <td>${t.reason}</td>
+      <td style="color:${t.pnl>=0?'#3fb950':'#f85149'}">$${t.pnl}</td>
+      <td>${t.R !== null ? t.R : '—'}</td>
+    </tr>
+  `).join('') : '<tr><td colspan="7" style="color:#8b949e">No trades in this window.</td></tr>';
+}
+
 </script>
 
 
